{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apple-pickup-live",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apple-pickup-live",
      "database_id": "e4ca41e1-76db-48d2-9692-fd5d6faa37de",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 8 * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "LIVE_CACHE",
      "id": "4a113361af2445e281b1601e0399e58b"
    }
  ]
}
