{
  "name": "apple-pickup-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 17910",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "collect": "node collector/runner.mjs",
    "deploy:pages": "npm run build && node scripts/build-pages.mjs && cd pages && wrangler pages deploy ../pages-dist --project-name apple-pickup-live --branch main && cd .. && node scripts/capture-site-shell.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  }
}
